# KaljiHome Environment Configuration
# Node environment
NODE_ENV=development
PORT=3000

# Secret key for session cookies (at least 32 characters)
SESSION_SECRET=change-this-in-production-to-a-cryptographically-random-32-char-key

# Secret key for keyed HMAC-SHA256 passcode storage (never commit production secrets)
PASSCODE_HMAC_SECRET=change-this-passcode-hmac-secret-in-production-entropy-required

# Database path (SQLite file path)
DATABASE_PATH=./data/kaljihome.db

# Email Notification Mode: 'sink' (local inspectable dev sink) or 'smtp' (live provider)
EMAIL_DELIVERY_MODE=sink
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=care@kaljihome.local
